# VMHost · 方案 2：注册 IActivityController，抑制 Watchdog 的 SIGKILL（vendor 版）。
#
# 为什么需要：TCG 全虚拟化下 system_server 主线程偶发 >60s 阻塞，而
# services.jar 里 Watchdog.java 的 DEFAULT_TIMEOUT 硬编码 60s，判定 OVERDUE 后
# 直接 Process.killProcess(myPid()) -> zygote 自杀重启 -> sys.boot_completed 反复丢失。
# Watchdog.run() 里唯一能让它「只回调不杀」的口子就是 mController。
#
# 以 root(uid 0) 运行：ActivityTaskManagerService.setActivityController 强制
# android.Manifest.permission.SET_ACTIVITY_WATCHER（signature 级），uid 0 直接 GRANTED。
# 程序自身会轮询 "activity" 服务并周期性重注册，所以早启动没关系。
#
# seclabel 说明：新建的文件是 u:object_r:unlabeled:s0，init 会因「标签错误/无域转换」
# 拒绝启动，显式指定一个已定义的域来绕过。选 incidentd 的依据（platform sepolicy）：
#   (allow incidentd system_server_service (service_manager (find)))
#   (allow incidentd system_server (binder (call transfer)))
#   (allow system_server incidentd (binder (call transfer)))
service vmhost_amctl /system/bin/sh /vendor/bin/vmhost_amctl.sh
    class late_start
    user root
    group root system
    seclabel u:r:incidentd:s0
    stdio_to_kmsg

# 额外保险：本 guest 以 androidboot.selinux=permissive 启动，但若 init 实际落到
# enforcing（audit=0 会把拒绝藏起来），这里尽力再置一次；失败只是多一行日志。
on early-init
    write /sys/fs/selinux/enforce 0
    # TCG 下 iorapd 一直重试 "Cannot get package manager service!"（PMS 未就绪前的纯空转），
    # 关掉以减少无谓的 CPU 争抢。
    setprop ro.iorapd.enable false
    # bootanim 在 TCG 下会一直占据一个渲染线程 + 每秒刷新，关掉把 CPU 让给开机路径。
    # SurfaceFlinger 在更晚的启动阶段才读它，early-init 设置能赶上。
    setprop debug.sf.nobootanimation 1
    # 跳过 SetupWizard：纯访客系统不需要，能省掉一整段初始化。
    setprop ro.setupwizard.mode DISABLED
    # 关掉默认锁屏：访客没有锁屏需求，且 SystemUI 的 KeyguardService 在 TCG 下
    # 反复 ANR（"Skipping duplicate ANR: … KeyguardService"）会拖死 UI 就绪。
    setprop ro.lockscreen.disable.default true
    # 关键：把系统各处超时统一放大。Android 用 ro.hw_timeout_multiplier 缩放
    # ANR / InputDispatcher 等超时，正是给 TCG 这类极慢环境准备的。
    # 不加的话，system_server/SystemUI 在正常硬件下毫秒级的工作在 TCG 下轻松破 60s，
    # 于是 ANR → 杀/重启 → UI 永远出不来。
    setprop ro.hw_timeout_multiplier 10

on post-fs
    write /sys/fs/selinux/enforce 0

# 尽早拉起：system_server 比 zygote 晚，且每次重启都会丢弃控制器，
# 但程序会持续重注册自愈，所以只要进程活着即可。
on zygote-start
    start vmhost_amctl

# ---------------------------------------------------------------------------
# 2026-10-11 启动负载精简：删掉了原先挂在本文件里的 4 个【临时诊断】服务
#   vmhost_evinfo (getevent -i) / vmhost_evlog (getevent -l) / vmhost_inlog (logcat)
#   / vmhost_infdump (dumpsys input)
# 实测 evinfo 一项就是 8.8s，且 evlog/inlog 是常驻服务，持续往内核日志写输入事件流，
# 既抢 CPU 又把 console.log 灌满。移除后 system_server 启动从 315.4s 提前到 300.7s。
# 需要复查输入链路时，再从 git 历史里取回这一段即可。
