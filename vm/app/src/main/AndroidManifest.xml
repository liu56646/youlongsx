<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 实例运行时挂前台服务：保住进程等级与 CPU 核（见 VmInstanceServiceBase） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 应用内自更新：下载新版 APK 后调起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.VmHost">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            实例运行时：每个实例一个 NativeActivity + 独立进程。
            meta-data android.app.lib_name 指向 libvmengine.so（不带 lib 前缀与 .so 后缀）。
            扩展实例数量 = 复制下方一组 <activity> 并同步 VmConstants.MAX_INSTANCES。
        -->
        <activity
            android:name=".instance.VmNativeActivity1"
            android:autoRemoveFromRecents="true"
            android:configChanges="density|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false"
            android:label="VM 1"
            android:launchMode="singleInstance"
            android:process=":vm1"
            android:taskAffinity="com.vm.app.vm1"
            android:theme="@style/Theme.VmHost.Fullscreen">
            <meta-data
                android:name="android.app.lib_name"
                android:value="vmengine" />
        </activity>

        <activity
            android:name=".instance.VmNativeActivity2"
            android:autoRemoveFromRecents="true"
            android:configChanges="density|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false"
            android:label="VM 2"
            android:launchMode="singleInstance"
            android:process=":vm2"
            android:taskAffinity="com.vm.app.vm2"
            android:theme="@style/Theme.VmHost.Fullscreen">
            <meta-data
                android:name="android.app.lib_name"
                android:value="vmengine" />
        </activity>

        <activity
            android:name=".instance.VmNativeActivity3"
            android:autoRemoveFromRecents="true"
            android:configChanges="density|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false"
            android:label="VM 3"
            android:launchMode="singleInstance"
            android:process=":vm3"
            android:taskAffinity="com.vm.app.vm3"
            android:theme="@style/Theme.VmHost.Fullscreen">
            <meta-data
                android:name="android.app.lib_name"
                android:value="vmengine" />
        </activity>

        <activity
            android:name=".instance.VmNativeActivity4"
            android:autoRemoveFromRecents="true"
            android:configChanges="density|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false"
            android:label="VM 4"
            android:launchMode="singleInstance"
            android:process=":vm4"
            android:taskAffinity="com.vm.app.vm4"
            android:theme="@style/Theme.VmHost.Fullscreen">
            <meta-data
                android:name="android.app.lib_name"
                android:value="vmengine" />
        </activity>

        <!--
            实例前台服务：与对应的 VmNativeActivityN 同进程，保证访客运行期间
            进程不被降级到 background cpuset、也不被冻结。
            Android 14+ 强制要求声明 foregroundServiceType，虚拟机归 specialUse。
        -->
        <service
            android:name=".instance.VmInstanceService1"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":vm1">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="virtual machine guest runtime" />
        </service>

        <service
            android:name=".instance.VmInstanceService2"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":vm2">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="virtual machine guest runtime" />
        </service>

        <service
            android:name=".instance.VmInstanceService3"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":vm3">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="virtual machine guest runtime" />
        </service>

        <service
            android:name=".instance.VmInstanceService4"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":vm4">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="virtual machine guest runtime" />
        </service>

        <!-- 访客网络：宿主侧 tun，供引擎的 slirp 桥接 -->
        <service
            android:name=".net.VmNetworkService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- 自更新：把 cacheDir/update 下的 APK 通过 content:// 交给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
